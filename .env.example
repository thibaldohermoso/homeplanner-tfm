NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Solo servidor: necesaria para habilitar la eliminación segura de cuentas.
# Nunca uses el prefijo NEXT_PUBLIC_ ni publiques este valor.
SUPABASE_SERVICE_ROLE_KEY=

# Solo para pruebas locales; no son necesarias en producción
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=
